<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Micrófono: solo para el dictado por voz, y solo cuando tocas 🎤 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Internet: SOLO para descargar una vez los idiomas de traducción. Lo que escribes no se envía. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Para encontrar el reconocimiento de voz del teléfono (app Google) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Escanear texto con la cámara -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:label="Escanear texto"
            android:windowSoftInputMode="stateHidden" />

        <!-- Comparte SOLO la imagen que pegas desde el portapapeles (permiso temporal) -->
        <provider
            android:name=".ClipProvider"
            android:authorities="com.luisell.bestkeyboard.clips"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".BestKeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
