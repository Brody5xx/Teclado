<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Micrófono: solo para el dictado por voz, y solo cuando tocas 🎤 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Cámara: solo para el escáner de texto, y solo cuando tocas el escáner -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Fotos: solo para sugerirte tu última captura de pantalla arriba del teclado -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Internet: SOLO para descargar una vez los idiomas de traducción. Lo que escribes no se envía. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Escribir dónde estás en el ticket (solo cuando tocas el botón) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Aviso diario del ticket -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Para sugerir el código de verificación de tus SMS (solo se lee dentro del teléfono) -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Para encontrar el reconocimiento de voz del teléfono (app Google) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".BestApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Corrector ortográfico de Android (subrayado rojo en las apps), español e inglés -->
        <service
            android:name=".BestSpellChecker"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_TEXT_SERVICE">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService" />
            </intent-filter>
            <meta-data
                android:name="android.view.textservice.scs"
                android:resource="@xml/spellchecker" />
        </service>

        <!-- Escanear texto con la cámara -->
        <!-- "Datos": correos, contraseñas y atajos -->
        <activity
            android:name=".DataActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- "Mis palabras": ver y editar lo aprendido -->
        <activity
            android:name=".WordsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Aviso del ticket del día (y volver a programarlo al prender el teléfono) -->
        <receiver
            android:name=".TicketReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Mi jornada: widget, botones y "Llegué" con GPS -->
        <receiver
            android:name=".WorkdayWidget"
            android:exported="false"
            android:label="Mi jornada">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_workday_info" />
        </receiver>
        <receiver
            android:name=".WorkdayReceiver"
            android:exported="false" />
        <activity
            android:name=".WorkdayActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Mis sitios -->
        <activity
            android:name=".SitesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Guía rápida -->
        <activity
            android:name=".GuideActivity"
            android:exported="false" />

        <!-- "Frases": tus frases rápidas -->
        <activity
            android:name=".PhrasesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- "Estilo": temas, colores, formas, animaciones, vibración y sonido -->
        <activity
            android:name=".StyleActivity"
            android:exported="false" />

        <!-- "Mis contraseñas": elegir una y confirmar con huella o PIN -->
        <activity
            android:name=".VaultPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:label="Escanear texto"
            android:windowSoftInputMode="stateHidden" />

        <!-- Comparte SOLO la imagen que pegas desde el portapapeles (permiso temporal) -->
        <provider
            android:name=".ClipProvider"
            android:authorities="com.luisell.bestkeyboard.clips"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".BestKeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
